digraph GESTION_VISUAL_DE_MEMORIA {
label=GESTION_VISUAL_DE_MEMORIA
rankdir=TB; nodesep=0.5; ranksep=0.8; splines=ortho;
subgraph cluster_Capas{
label="Capas"
style = "filled,rounded"; ordering=out;
lyr_1[label="lyr_1", shape=box, style=filled, fillcolor="#FF333340"];
lyr_2[label="lyr_2", shape=box, style=filled, fillcolor="#FF333340"];
lyr_3[label="lyr_3", shape=box, style=filled, fillcolor="#FF333340"];
lyr_1 -> lyr_2 [color="#FF333340"];
lyr_2 -> lyr_3 [color="#FF333340"];

}

subgraph cluster_Imagenes{
label="Imagenes"
style = "filled,rounded"; ordering=out;

}

subgraph cluster_Usuarios{
label="Usuarios"
style = "filled,rounded"; ordering=out;

}


}