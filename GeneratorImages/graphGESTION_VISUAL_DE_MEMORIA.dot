digraph GESTION_VISUAL_DE_MEMORIA {
label=GESTION_VISUAL_DE_MEMORIA
rankdir="LR"; nodesep=0.5; ranksep=0.8; splines=ortho;
subgraph cluster_Capas{
label="Capas"
style = "filled,rounded"; ordering=out;
lyr_1[label="lyr_1", shape=box, style=filled, fillcolor="#FF333340"];
lyr_2[label="lyr_2", shape=box, style=filled, fillcolor="#FF333340"];
lyr_3[label="lyr_3", shape=box, style=filled, fillcolor="#FF333340"];
lyr_2 -> lyr_1 [color="#FF333340", id="bst"];
lyr_2 -> lyr_3 [color="#FF333340", id="bst"];

}

subgraph cluster_Imagenes{
label="Imagenes"
style = "filled,rounded"; ordering=out;
img_1[label="img_1", shape=box, style=filled, fillcolor="#7FBA85"];
{rank=same; img_1; }img_1 -> i1_lyr_1 [color="#7FBA85", color="#3E444D"];
i1_lyr_1[label="i1_lyr_1"shape=record, style=filled, fillcolor="#9999C7"];
i1_lyr_1 -> lyr_1 [color="#7FBA85", color="#3E444D", style=dotted];
i1_lyr_1 -> i1_lyr_2 [color="#7FBA85", color="#3E444D"];
i1_lyr_2[label="i1_lyr_2"shape=record, style=filled, fillcolor="#9999C7"];
i1_lyr_2 -> lyr_2 [color="#7FBA85", color="#3E444D", style=dotted];
i1_lyr_2 -> i1_lyr_3 [color="#7FBA85", color="#3E444D"];
i1_lyr_3[label="i1_lyr_3"shape=record, style=filled, fillcolor="#9999C7"];
i1_lyr_3 -> lyr_3 [color="#7FBA85", color="#3E444D", style=dotted];
img_2[label="img_2", shape=box, style=filled, fillcolor="#7FBA85"];
{rank=same; img_1; img_2; }img_2 -> i2_lyr_2 [color="#7FBA85", color="#3E444D"];
i2_lyr_2[label="i2_lyr_2"shape=record, style=filled, fillcolor="#9999C7"];
i2_lyr_2 -> lyr_2 [color="#7FBA85", color="#3E444D", style=dotted];
i2_lyr_2 -> i2_lyr_1 [color="#7FBA85", color="#3E444D"];
i2_lyr_1[label="i2_lyr_1"shape=record, style=filled, fillcolor="#9999C7"];
i2_lyr_1 -> lyr_1 [color="#7FBA85", color="#3E444D", style=dotted];
i2_lyr_1 -> i2_lyr_3 [color="#7FBA85", color="#3E444D"];
i2_lyr_3[label="i2_lyr_3"shape=record, style=filled, fillcolor="#9999C7"];
i2_lyr_3 -> lyr_3 [color="#7FBA85", color="#3E444D", style=dotted];
img_3[label="img_3", shape=box, style=filled, fillcolor="#7FBA85"];
img_1 -> img_2 [color="#7FBA85", dir=both ,id="principalimg"];
img_2 -> img_3 [color="#7FBA85", dir=both ,id="principalimg"];
img_3 -> img_1 [color="#7FBA85", dir=both ,id="principalimg"];
{rank=same; img_1; img_2; img_3; }img_3 -> i3_lyr_1 [color="#7FBA85", color="#3E444D"];
i3_lyr_1[label="i3_lyr_1"shape=record, style=filled, fillcolor="#9999C7"];
i3_lyr_1 -> lyr_1 [color="#7FBA85", color="#3E444D", style=dotted];
i3_lyr_1 -> i3_lyr_3 [color="#7FBA85", color="#3E444D"];
i3_lyr_3[label="i3_lyr_3"shape=record, style=filled, fillcolor="#9999C7"];
i3_lyr_3 -> lyr_3 [color="#7FBA85", color="#3E444D", style=dotted];
i3_lyr_3 -> i3_lyr_2 [color="#7FBA85", color="#3E444D"];
i3_lyr_2[label="i3_lyr_2"shape=record, style=filled, fillcolor="#9999C7"];
i3_lyr_2 -> lyr_2 [color="#7FBA85", color="#3E444D", style=dotted];

}

subgraph cluster_Usuarios{
label="Usuarios"
style = "filled,rounded"; ordering=out;
us_1[label="userM", shape=box, style=filled, fillcolor=white];
us_1_img1[label="us_1_img1"shape=record, style=filled, fillcolor="#74B2C2"];
us_1 -> us_1_img1 [color=white, color= "#D8E7F0"];
us_1_img1 -> img_1 [color=white, style=dotted, color= "#1C4F69", id="conimg_1"];
us_2[label="userB", shape=box, style=filled, fillcolor=white];
us_2_img1[label="us_2_img1"shape=record, style=filled, fillcolor="#74B2C2"];
us_2 -> us_2_img1 [color=white, color= "#D8E7F0"];
us_2_img1 -> img_1 [color=white, style=dotted, color= "#1C4F69", id="conimg_1"];
us_2_img2[label="us_2_img2"shape=record, style=filled, fillcolor="#74B2C2"];
us_2_img1 -> us_2_img2 [color=white, color="#D8E7F0"];
us_2_img2 -> img_2 [color=white, style=dotted, color= "#1C4F69", id="conimg_2"];
us_3[label="userA", shape=box, style=filled, fillcolor=white];
us_3_img1[label="us_3_img1"shape=record, style=filled, fillcolor="#74B2C2"];
us_3 -> us_3_img1 [color=white, color= "#D8E7F0"];
us_3_img1 -> img_1 [color=white, style=dotted, color= "#1C4F69", id="conimg_1"];
us_3_img2[label="us_3_img2"shape=record, style=filled, fillcolor="#74B2C2"];
us_3_img1 -> us_3_img2 [color=white, color="#D8E7F0"];
us_3_img2 -> img_2 [color=white, style=dotted, color= "#1C4F69", id="conimg_2"];
us_3_img3[label="us_3_img3"shape=record, style=filled, fillcolor="#74B2C2"];
us_3_img2 -> us_3_img3 [color=white, color="#D8E7F0"];
us_3_img3 -> img_3 [color=white, style=dotted, color= "#1C4F69", id="conimg_3"];
us_4[label="userY", shape=box, style=filled, fillcolor=white];
us_1 -> us_2 [color=white, id="bst"];
us_2 -> us_3 [color=white, id="bst"];
us_3 -> us_4 [color=white, id="bst"];
us_4_img3[label="us_4_img3"shape=record, style=filled, fillcolor="#74B2C2"];
us_4 -> us_4_img3 [color=white, color= "#D8E7F0"];
us_4_img3 -> img_3 [color=white, style=dotted, color= "#1C4F69", id="conimg_3"];

}


}